# ══════════════════════════════════════════════════════════
# UltraCounsel — Apex Coaching Institute Voice Counsellor
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════════════════

# ── Plivo (telephony) ─────────────────────────────────────
# Get from: https://console.plivo.com/dashboard/
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Ultravox (voice AI) ───────────────────────────────────
# Get from: https://app.ultravox.ai/settings/api-keys
ULTRAVOX_API_KEY=your_ultravox_api_key
ULTRAVOX_BASE_URL=https://api.ultravox.ai

# ── PostgreSQL (database) ─────────────────────────────────
# Vercel Postgres, Supabase, or any PostgreSQL URL
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/ultracounsel

# ── Security ──────────────────────────────────────────────
# Random secret for phone number hashing — NEVER share this
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_HASH_SALT=your_random_32_char_secret_here

# ── Institute Details ─────────────────────────────────────
INSTITUTE_NAME=Apex Coaching Institute
INSTITUTE_PHONE=+911234567890
INSTITUTE_WEBSITE=https://apexcoaching.in
ADMISSION_WHATSAPP=+911234567890

# ── App ───────────────────────────────────────────────────
# Your deployment URL (used to build webhook callback URLs for Ultravox tools)
# During local dev: use ngrok URL e.g. https://abcd1234.ngrok.io
APP_BASE_URL=https://your-deployment.vercel.app

# ── Email (optional) ─────────────────────────────────────
# Required only if you add email support in the future
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=admissions@apexcoaching.in

# ── Misc ─────────────────────────────────────────────────
LOG_LEVEL=INFO
SESSION_RETENTION_DAYS=90
